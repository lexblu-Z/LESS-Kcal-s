# Servidor Backend
PORT=3001
NODE_ENV=development

# Banco de Dados (PostgreSQL padrão)
# Exemplo local: postgresql://<usuario>:<senha>@localhost:5432/<nome_banco>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/less_kcals?schema=public"

# Autenticação JWT
JWT_SECRET="less_kcals_super_secret_jwt_key_2026_change_in_production"
JWT_EXPIRES_IN="7d"

# Integração com IA (Google Gemini API / OpenAI API)
# Se não configurada, o backend utiliza o motor de processamento em linguagem natural local (fallback inteligente)
GEMINI_API_KEY=""
AI_MODEL="gemini-1.5-flash"

# CORS Frontend permitido
CORS_ORIGIN="http://localhost:5173"
