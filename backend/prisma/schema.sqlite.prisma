// Prisma Schema para LESS-Kcal-s (Versão SQLite para desenvolvimento local leve e testes)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyGoals    DailyGoal[]
  meals         Meal[]
  customFoods   Food[]         @relation("UserCustomFoods")
  favoriteFoods FavoriteFood[]

  @@map("users")
}

model DailyGoal {
  id        String   @id @default(uuid())
  userId    String
  date      String   // Formato YYYY-MM-DD
  calories  Float
  proteins  Float
  carbs     Float
  fats      Float
  waterMl   Int?     @default(2000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_goals")
}

model Food {
  id           String   @id @default(uuid())
  name         String
  category     String
  source       String   @default("TACO")
  baseUnit     String   @default("g")
  baseQuantity Float    @default(100)
  calories     Float
  proteins     Float
  carbs        Float
  fats         Float
  fibers       Float    @default(0)
  servingSize  Float?
  servingUnit  String?
  isCustom     Boolean  @default(false)
  userId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user          User?          @relation("UserCustomFoods", fields: [userId], references: [id], onDelete: SetNull)
  mealItems     MealItem[]
  favoriteFoods FavoriteFood[]

  @@index([name])
  @@index([category])
  @@index([userId])
  @@map("foods")
}

model Meal {
  id        String   @id @default(uuid())
  userId    String
  date      String   // Formato YYYY-MM-DD
  mealType  String   // BREAKFAST, LUNCH, AFTERNOON_SNACK, DINNER, SUPPER
  name      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MealItem[]

  @@index([userId, date])
  @@map("meals")
}

model MealItem {
  id              String   @id @default(uuid())
  mealId          String
  foodId          String?
  name            String
  quantity        Float
  unit            String
  gramsEquivalent Float
  calories        Float
  proteins        Float
  carbs           Float
  fats            Float
  fibers          Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  meal Meal  @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food Food? @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@index([mealId])
  @@map("meal_items")
}

model FavoriteFood {
  id        String   @id @default(uuid())
  userId    String
  foodId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([userId, foodId])
  @@index([userId])
  @@map("favorite_foods")
}
